# ===================================
# E2E Test Environment Configuration
# ===================================
# Copy this file to .env.test for local E2E testing
# In CI/CD, these values are provided as environment variables

# Database - Use separate database for tests
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vegan_vita_test

# JWT - Must match the default in code
JWT_SECRET=VeganVita!Test2024SecureKey@Min32
JWT_EXPIRES_IN=7d

# SMTP - Test configuration
SMTP_HOST=smtp.test.com
SMTP_PORT=587
SMTP_USER=test@test.com
SMTP_PASS=test-password
SMTP_FROM="VeganVita Test <noreply@test.com>"

# Application
FRONTEND_URL=http://localhost:3001
NODE_ENV=test
